<Window x:Class="Wpf_action_loose_coupling.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_action_loose_coupling"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <!--<ControlTemplate TargetType="{x:Type Window}">
       
    </ControlTemplate>-->
    <Grid>
        <StatusBar Margin="20">
            <StatusBarItem  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{x:Static ApplicationCommands.Close}" Width="300" Height="150"
                        Content="Close"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
