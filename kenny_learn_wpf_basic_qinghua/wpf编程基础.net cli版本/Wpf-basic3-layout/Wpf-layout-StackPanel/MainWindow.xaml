<Window x:Class="Wpf_layout_StackPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_layout_StackPanel"
        mc:Ignorable="d"
        Title="Wpf App" Height="220" Width="240">
    <StackPanel Background="AliceBlue">
        <TextBlock Text="Look for:" Margin="4"/>
        <ComboBox Margin="4" /> 
        <TextBlock Text="Filter By:" Margin="4"/>
        <ComboBox Margin="4" />
        <Button Margin="4,5" Content="Search" />
        <CheckBox Margin="4" Content="Search in Titles Only" />
        <CheckBox Margin="4" Content="Search in Keyword" />
    </StackPanel>
</Window>
