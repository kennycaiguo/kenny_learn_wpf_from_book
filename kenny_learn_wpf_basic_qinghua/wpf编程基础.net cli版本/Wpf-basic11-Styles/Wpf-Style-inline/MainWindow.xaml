<Window x:Class="Wpf_Style_inline.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Style_inline"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="300">
    <Grid>
        <Button>
            <Button.Style>
                <Style>
                    <Setter Property="Button.FontSize" Value="20" />
                    <Setter Property="Button.Width" Value="250" />
                    <Setter Property="Button.Height" Value="90" />
                    <Setter Property="Button.Background" Value="Gold" />
                </Style>
            </Button.Style>
            Hello Button
        </Button>
    </Grid>
</Window>
