<Window x:Class="Wpf_styles_singleprop_trigger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_styles_singleprop_trigger"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="800">
    <Window.Resources>
        <Style TargetType="Button">
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="Content" Value="按钮"/>
                        <Condition Property="Visibility" Value="Visible"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="ToolTip" Value="这是一个中文可见按钮" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <StackPanel>
        <Button Margin="50,50" FontSize="48">按钮</Button>
        <Button Margin="50,20" FontSize="48">Button</Button>
    </StackPanel>
</Window>
