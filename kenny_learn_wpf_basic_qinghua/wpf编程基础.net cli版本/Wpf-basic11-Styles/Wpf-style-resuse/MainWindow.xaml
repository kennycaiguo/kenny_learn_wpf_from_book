<Window x:Class="Wpf_style_resuse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_style_resuse"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Window.Resources>
        <Style x:Key="style1">
            <Setter Property="Button.FontSize" Value="40" />
            <Setter Property="Button.Width" Value="250" />
            <Setter Property="Button.Height" Value="90" />
            <Setter Property="Label.Background" Value="Gold" />
            <Setter Property="TextBlock.FontStyle" Value="Italic" />
            <Setter Property="TextBlock.Foreground" Value="DeepPink" />
        </Style>
    </Window.Resources>
    <StackPanel>
        <Button Margin="5" Style="{StaticResource style1}" Content="Button"/>
        <Label Margin="5"  Style="{StaticResource style1}" Content="Label1" />
        <TextBlock Style="{StaticResource style1}" Text=" a TextBlock" />
    </StackPanel>
</Window>
