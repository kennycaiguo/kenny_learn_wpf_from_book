<Window x:Class="Wpf_style_code_change_style.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_style_code_change_style"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style x:Key="style1" TargetType="Control">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="Width" Value="250" />
            <Setter Property="Height" Value="90" />
            <Setter Property="Background" Value="Gold" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Foreground" Value="DeepPink" />
        </Style>
        <Style x:Key="style2" TargetType="Control">
            <Setter Property="FontSize" Value="50" />
            <Setter Property="Width" Value="250" />
            <Setter Property="Height" Value="90" />
            <Setter Property="Background" Value="LimeGreen" />
            <Setter Property="FontStyle" Value="Oblique" />
            <Setter Property="Foreground" Value="Wheat" />
        </Style>
    </Window.Resources>
    <Grid>
        <Label x:Name="label1" Style="{StaticResource style1}" Margin="10,10,300,300"  Content="Label1" />
        <Button Content="Change Style" FontSize="45" Margin="100,200,150,100" Click="Button_Click"/>
    </Grid>
</Window>
