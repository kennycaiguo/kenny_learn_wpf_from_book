<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="style1">
        <Setter Property="ItemsControl.Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="Violet" />
                    <GradientStop Offset="0.5" Color="Pink" />
                    <GradientStop Offset="1" Color="Cyan" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="style2">
        <Setter Property="ItemsControl.Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="Yellow" />
                    <GradientStop Offset="0.5" Color="GreenYellow" />
                    <GradientStop Offset="1" Color="Green" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>