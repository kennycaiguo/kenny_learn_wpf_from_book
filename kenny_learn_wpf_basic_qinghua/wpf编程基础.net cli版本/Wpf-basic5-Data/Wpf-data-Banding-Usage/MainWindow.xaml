<Window x:Class="Wpf_data_Banding_Usage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_data_Banding_Usage"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <!--Slider控件绑定TextBox控件-->
        <Grid Grid.Row="0">
            <Slider Name="slider1" Height="23" HorizontalAlignment="Left" Margin="10,50,0,0"
                    VerticalAlignment="Top" Width="188"/>
            <TextBox Name="textBox1" Height="23" HorizontalAlignment="Left" VerticalAlignment="Top" Width="188"
                     Margin="10,93,0,0" Text="{Binding ElementName=slider1, Path=Value,Mode=TwoWay}"/>
        </Grid>
        <!--两个相同的TextBox控件的绑定-->
        <StackPanel Grid.Row="1" >
            <Label>Input String</Label>
            <TextBox Name="tbInput" />
            <Label>OUtput String</Label>
            <TextBox Name="tbOutput" Text="{Binding Text,ElementName=tbInput,UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
    </Grid>
</Window>
