<Window x:Class="Wpf_data_Banding_ConvertDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_data_Banding_ConvertDemo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <TextBox x:Name="textBox1"/>
        <TextBox x:Name="textBox2"/>
        <ContentControl Margin="8" Height="117" FontFamily="{Binding ElementName=textBox2, Path=Text}" >
            <ContentControl.Content>
                <Binding ElementName="textBox1" Path="Text" >
                    <Binding.Converter>
                        <local:PersonConverter xmlns:local="clr-namespace:Wpf_data_Banding_ConvertDemo" >

                        </local:PersonConverter>
                    </Binding.Converter>
                </Binding>
            </ContentControl.Content>
            <ContentControl.ContentTemplate>
                <DataTemplate xmlns:local="clr-namespace:Wpf_data_Banding_ConvertDemo"
                              DataType="{x:Type local:Person}">
                    <Border Margin="8" Padding="5" BorderBrush="Green" BorderThickness="5" CornerRadius="3" >
                        <TextBlock Text="{Binding Path=Name}"/>
                    </Border>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </StackPanel>
</Window>
