<Window x:Class="Wpf_data_Banding_Usage_Resource_value_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_data_Banding_Usage_Resource_value_"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <sys:String x:Key="str">hello</sys:String>
    </Window.Resources>
    <StackPanel>
        <Label>Read From Resource</Label>
        <TextBox x:Name="textbox1" Text="{StaticResource str}" />
        <TextBox Text="{Binding Text,ElementName=textbox1,UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</Window>
