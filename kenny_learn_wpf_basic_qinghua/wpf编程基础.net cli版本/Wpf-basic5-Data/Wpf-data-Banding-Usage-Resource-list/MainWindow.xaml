<Window x:Class="Wpf_data_Banding_Usage_Resource_list.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_data_Banding_Usage_Resource_list"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <!--定义一些窗口的资源-->
    <Window.Resources>
        <local:Users x:Key="Userset">
            <local:User Name="赵子龙" Age="120"/>
            <local:User Name="谢浩然" Age="10"/>
            <local:User Name="林黛玉" Age="20"/>
            <local:User Name="花木兰" Age="90"/>
            <local:User Name="诸葛亮" Age="120"/>
            <local:User Name="穆桂英" Age="90"/>
            <local:User Name="李婉童" Age="10"/>
        </local:Users>
    </Window.Resources>
    <Grid Name="grid" Height="195" DataContext="{StaticResource Userset}">
        <TextBlock Height="23" HorizontalAlignment="Left" Margin="10,-106,0,0" Name="textBlock3"
          VerticalAlignment="Top" Width="43" Text="Dataset:"/>
        <ListBox ItemsSource="{Binding}" IsSynchronizedWithCurrentItem="True" SelectedValuePath="Age"
         DisplayMemberPath="Name" Height="96" HorizontalAlignment="Left" Margin="10,-78,0,0" 
         Name="userListBox" VerticalAlignment="Top" Width="179" Grid.ColumnSpan="2"/>
        <TextBlock Height="24" HorizontalAlignment="Left" Margin="12,55,0,0" Name="textBlock1"
                 VerticalAlignment="Top" Width="43"  Text="Name:"/>
        <TextBlock Height="23" HorizontalAlignment="Left" Margin="21,0,0,0" Name="textBlock2"
                 VerticalAlignment="Center" Width="43" Text="Age:"/>
        <TextBox Text="{Binding Path=Name}"  Name="nameTextBox" Height="23" HorizontalAlignment="Left"
                 Margin="70,56,0,0" VerticalAlignment="Top" Width="120" Grid.ColumnSpan="2" />
        <TextBox Text="{Binding Path=Age}"  Name="ageTextBox" Height="23" HorizontalAlignment="Left"
                 Margin="69,89,0,0" VerticalAlignment="Top" Width="120" Grid.ColumnSpan="2" />

        <Button Content="First" Height="23" HorizontalAlignment="Left" Margin="6,127,0,0" 
                Name="firstButton" VerticalAlignment="Top" Width="47" Click="firstButton_Click"/>
        <Button Content="Previo" Height="23" HorizontalAlignment="Left" Margin="172,127,0,0" 
                Name="previousButton" VerticalAlignment="Top" Width="47" Click="previousButton_Click" RenderTransformOrigin="2.199,0.632"/>
        <Button Content="Next" Height="23" HorizontalAlignment="Left" Margin="83,127,0,0" 
                Name="nextButton" VerticalAlignment="Top" Width="47" Click="nextButton_Click"/>
        <Button Content="Last" Height="23" HorizontalAlignment="Left" Margin="255,127,0,0" 
                Name="lastButton" VerticalAlignment="Top" Width="47" Click="lastButton_Click"/>
    </Grid>
</Window>
