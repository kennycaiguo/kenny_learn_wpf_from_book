<Window x:Class="Wpf_ctrl_slider_scrollbar_progressbar_.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_ctrl_slider_scrollbar_progressbar_"
        mc:Ignorable="d"
        Title="MainWindow" Height="150" Width="400">
    <Grid>
        <TabControl>
            <TabItem Header="Slider">
               <Slider Maximum="100" Minimum="0" Value="50" IsSnapToTickEnabled="True" 
                 TickPlacement="BottomRight" TickFrequency="5"  IsSelectionRangeEnabled="True"
                 SelectionStart="50" SelectionEnd="90"/>
            </TabItem>
            <TabItem Header="Scroll Bar">
                <ScrollBar Orientation="Horizontal" Width="250" Height="20" Margin="10" Background="LightSalmon"
                           Minimum="8" Maximum="350" Value="100"/>
            </TabItem>
            <TabItem Header="Progress Bar">
                <ProgressBar Width="250" Height="15" IsIndeterminate="True" Foreground="LawnGreen" Background="Gray" />
            </TabItem>
        </TabControl>
        
    </Grid>
</Window>
