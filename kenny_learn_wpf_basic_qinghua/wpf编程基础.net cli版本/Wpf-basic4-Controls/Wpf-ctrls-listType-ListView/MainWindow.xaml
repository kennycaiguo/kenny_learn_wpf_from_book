<Window x:Class="Wpf_ctrls_listType_ListView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_ctrls_listType_ListView"
        mc:Ignorable="d"
        Title="红楼梦" Height="350" Width="350">
    <Grid>
        <ListView Name="lv" ItemsSource="{Binding}" >
            <ListView.View>
                <GridView AllowsColumnReorder="True">
                    <GridViewColumn Width="100" Header="姓名" DisplayMemberBinding="{Binding Path=Name}"></GridViewColumn>
                    <GridViewColumn Width="100" Header="性别" DisplayMemberBinding="{Binding Path=Gender}"></GridViewColumn>
                    <GridViewColumn Width="150" Header="房间" DisplayMemberBinding="{Binding Path=RoomName}"></GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
