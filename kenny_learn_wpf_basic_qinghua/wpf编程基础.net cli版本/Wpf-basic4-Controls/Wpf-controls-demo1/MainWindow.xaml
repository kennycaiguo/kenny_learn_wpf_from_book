<Window x:Class="Wpf_controls_demo1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_controls_demo1"
        mc:Ignorable="d"
        Title="Custom Window" Height="450" Width="525">
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <Border BorderThickness="3" BorderBrush="Purple" Background="GreenYellow">
                <Grid>
                    <Rectangle Fill="Pink" Margin="8" />
                    <TextBlock Margin="90" Text="{TemplateBinding Property=Title}" 
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40"/>
                </Grid>
            </Border>
        </ControlTemplate>
    </Window.Template>
</Window>
