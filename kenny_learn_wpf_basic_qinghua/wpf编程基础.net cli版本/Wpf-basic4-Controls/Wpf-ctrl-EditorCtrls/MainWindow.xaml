<Window x:Class="Wpf_ctrl_EditorCtrls.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_ctrl_EditorCtrls"
        mc:Ignorable="d"
        Title="MainWindow" Height="257" Width="507">
    <Grid>
        <StackPanel>

            <TextBlock x:Name="Tblock" Text="this is a text block" FontSize="30" />
            <TextBox AcceptsReturn="True" TextWrapping="Wrap" FontSize="30" Text="Hello Text Box" />
            <RichTextBox x:Name="richEdit">
                <FlowDocument FontSize="30">
                    <Paragraph>
                        Inside RichText Box
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
           
        </StackPanel>

    </Grid>
</Window>
