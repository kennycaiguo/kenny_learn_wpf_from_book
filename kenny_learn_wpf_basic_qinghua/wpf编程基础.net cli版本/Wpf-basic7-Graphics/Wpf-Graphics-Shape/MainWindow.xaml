<Window x:Class="Wpf_Graphics_Shape.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Graphics_Shape"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas Height="292">
        <Rectangle Width="100" Height="50" Canvas.Left="35" Canvas.Top="33" Fill="Violet" 
                   RadiusX="30" RadiusY="50" />
        <Polygon Fill="Orange" Stroke="Green" StrokeThickness="2" Points="10,20 100,50 10,80 66,3 66,98"
                 Canvas.Left="204" Canvas.Top="12" Height="103" Width="105" />
        <Rectangle Width="40" Height="10" Canvas.Left="411" Canvas.Top="63" Fill="LightGreen" />
        <Rectangle Width="40" Height="10" Canvas.Left="411" Canvas.Top="63" Fill="Violet">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="45" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="40" Height="10" Canvas.Left="411" Canvas.Top="63" Fill="Violet">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="90" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="40" Height="10" Canvas.Left="411" Canvas.Top="63" Fill="Violet">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="135" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="40" Height="10" Canvas.Left="411" Canvas.Top="63" Fill="Violet">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="180" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="40" Height="10" Canvas.Left="411" Canvas.Top="63" Fill="Violet">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="225" />
            </Rectangle.RenderTransform>
        </Rectangle> 
        <Rectangle Width="40" Height="10" Canvas.Left="411" Canvas.Top="63" Fill="Violet">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="270" />
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Width="40" Height="10" Canvas.Left="411" Canvas.Top="63" Fill="Violet">
            <Rectangle.RenderTransform>
                <RotateTransform Angle="325" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Canvas>
</Window>
