<Window x:Class="Wpf_resource_dynamic_load.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_resource_dynamic_load"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <ImageBrush x:Key="imgBrush" TileMode="None" ImageSource="/Resources/Images/romantic3.png" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition  Height="30"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" x:Name="grid1" Background="{DynamicResource imgBrush}"/>
        <Button Grid.Row="1" Content="加载动态资源" Click="Button_Click"/>
    </Grid>
</Window>
