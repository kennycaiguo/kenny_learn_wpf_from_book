<Window x:Class="Wpf_Resource_demo1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_Resource_demo1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <SolidColorBrush x:Key="goldBursh" Color="Gold"/>
    </Window.Resources>
    <StackPanel>
        <Button Margin="5" Content="Gold Button" Background="{StaticResource goldBursh}" />
        <TextBlock Margin="5" Text="Gold Text Block" Foreground="{StaticResource goldBursh}"
                   FontSize="24"/>
        <Rectangle Margin="5" Width="500" Height=" 300" Fill="{StaticResource goldBursh}" />
    </StackPanel>
</Window>
